# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for Matthew AI Business Development Intelligence
OPENAI_API_KEY="sk-..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Cloudflare R2 Credentials (Server-side)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="https://your-public-r2-url.dev"

# Paystack Gateway Credentials
# Server-side Secret Key (sk_live_... or sk_test_...) - Never exposed to client
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
# Public Key (pk_live_... or pk_test_...)
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"

